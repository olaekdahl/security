# ── Vault connection (used by the Node app) ────────────────────────────
# When Vault runs in the docker-compose dev container it listens on HTTP.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root

# ── App session ────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-value

# ── Okta credentials (consumed by the vault-seed container) ─────────────
# These are written into Vault at secret/okta by `docker compose up`.
OKTA_CLIENT_ID=your-okta-client-id
OKTA_CLIENT_SECRET=your-okta-client-secret
